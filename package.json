{
  "name": "mope-rules-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-mope \"node --test --test-concurrency=1 tests/firestore/*.test.mjs\"",
    "test:auth:android": "firebase emulators:exec --only auth,firestore --project demo-mope \"./gradlew -PmopeBackend=emulator :app:connectedDebugAndroidTest\"",
    "test:auth:restart": "firebase emulators:exec --only auth,firestore --project demo-mope \"node scripts/test-auth-restart.mjs\"",
    "test:chat:android": "firebase emulators:exec --only auth,firestore --project demo-mope \"./gradlew -PmopeBackend=emulator -Pandroid.testInstrumentationRunnerArguments.class=com.mope.app.data.FirestoreChatRepositoryTest :app:connectedDebugAndroidTest\"",
    "dev:firebase": "firebase emulators:start --only auth,firestore --project demo-mope",
    "seed:chat:demo": "node scripts/seed-chat-demo.mjs",
    "test:chat:demo": "firebase emulators:exec --only auth,firestore --project demo-mope \"node --test tests/demo/chat-demo.test.mjs\"",
    "test:request:android": "firebase emulators:exec --only auth,firestore --project demo-mope \"./gradlew -PmopeBackend=emulator -Pandroid.testInstrumentationRunnerArguments.class=com.mope.app.data.FirestoreClubRequestRepositoryTest :app:connectedDebugAndroidTest\"",
    "check:firebase": "node scripts/check-firebase-config.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "verify:backend": "node scripts/verify-backend.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.10.0",
    "firebase-tools": "15.34.2"
  }
}
