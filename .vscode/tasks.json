{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Android: Build MOPE",
            "type": "shell",
            "command": "./gradlew",
            "args": ["assembleDebug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "JAVA_HOME": "/Applications/Android Studio.app/Contents/jbr/Contents/Home" }
            },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Android: Install MOPE",
            "type": "process",
            "command": "${env:HOME}/Library/Android/sdk/platform-tools/adb",
            "args": ["-e", "install", "--no-streaming", "-r", "${workspaceFolder}/app/build/outputs/apk/debug/app-debug.apk"],
            "dependsOn": "Android: Build MOPE",
            "problemMatcher": []
        },
        {
            "label": "Android: Run MOPE",
            "type": "process",
            "command": "${env:HOME}/Library/Android/sdk/platform-tools/adb",
            "args": ["-e", "shell", "am", "start", "-S", "-W", "-n", "com.mope.app/.MainActivity"],
            "dependsOn": "Android: Install MOPE",
            "problemMatcher": []
        }
    ]
}
