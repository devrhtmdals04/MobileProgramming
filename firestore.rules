rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(data) {
      return data.keys().hasAll(['displayName', 'role', 'createdAt'])
        && data.keys().hasOnly(['displayName', 'role', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 30
        && data.displayName.matches('.*[^\\s].*')
        && data.role in ['student', 'club_admin']
        && data.createdAt is timestamp;
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      // 목록 조회·삭제 및 나머지 경로는 기본 거절한다.
    }
    function validChatId(value) {
      return value is string && value.size() >= 1 && value.size() <= 128
        && value.split('__').size() == 1 && value.split('/').size() == 1;
    }
    // Published club documents contain public fields only; management is scoped to the assigned owner.
    match /clubs/{clubId} {
      allow get, list: if request.auth != null;
      allow create: if validManagedClub(request.resource.data, clubId)
        && verifiedFirstGrant(clubId, request.resource.data);
      allow update: if validManagedClub(request.resource.data, clubId) && (
        (resource.data.get('adminId', '') == '' && verifiedFirstGrant(clubId, request.resource.data))
        || (request.auth != null && resource.data.adminId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'recruitment', 'updatedAt'])));
      match /publicContacts/{contactId} {
        // 공개용 필드만 읽는다. 클라이언트의 편집·목록 조회는 허용하지 않는다.
        allow get: if request.auth != null
          && (!exists(/databases/$(database)/documents/clubs/$(clubId)/publicContacts/$(contactId))
            || validPublicContact(resource.data));
      }
    }
    function validPublicContact(data) {
      return data.keys().hasAll(['displayName', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'responseHint', 'updatedAt'])
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30
        && data.displayName.matches('(?s).*[^\\s].*') && data.updatedAt is timestamp
        && (!('responseHint' in data) || (data.responseHint is string
          && data.responseHint.size() >= 1 && data.responseHint.size() <= 120
          && data.responseHint.matches('(?s).*[^\\s].*')));
    }
    function isOperator() {
      return request.auth != null && (request.auth.token.get('operator', false) == true
        || (exists(/databases/$(database)/documents/operators/$(request.auth.uid))
          && get(/databases/$(database)/documents/operators/$(request.auth.uid)).data.get('enabled', false) == true));
    }
    // Only the trusted project administrator can register/revoke dedicated operators.
    match /operators/{uid} {
      allow get: if isOwner(uid);
    }
    function canonicalClubId(id) {
      return id is string && id.matches('ssu-[1-9][0-9]{0,8}');
    }
    function unassignedClub(id) {
      return !exists(/databases/$(database)/documents/clubs/$(id))
        || get(/databases/$(database)/documents/clubs/$(id)).data.get('adminId', '') == '';
    }
    function validManagedClub(data, id) {
      return canonicalClubId(id)
        && data.keys().hasAll(['name', 'category', 'description', 'recruitment', 'adminId', 'sourceUrl', 'updatedAt'])
        && data.keys().hasOnly(['name', 'category', 'description', 'recruitment', 'adminId', 'sourceUrl', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 30
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 2000
        && data.description.matches('(?s).*[^\\s].*')
        && data.recruitment is string && data.recruitment.size() <= 1000
        && validChatId(data.adminId)
        && data.sourceUrl == 'https://clubunion.ssu.ac.kr/clubs/' + id.split('-')[1]
        && data.updatedAt == request.time;
    }
    function verifiedFirstGrant(id, data) {
      let requestId = id + '__' + data.adminId;
      let before = get(/databases/$(database)/documents/clubAdminRequests/$(requestId)).data;
      let after = getAfter(/databases/$(database)/documents/clubAdminRequests/$(requestId)).data;
      return isOperator() && before.status == 'pending'
        && before.clubId == id && before.applicantId == data.adminId
        && after.status == 'approved' && after.reviewedBy == request.auth.uid
        && after.reviewedAt == request.time;
    }
    function validAdminApplication(data, id) {
      return data.keys().hasAll(['clubId', 'clubName', 'applicantId', 'reason', 'status', 'createdAt',
          'reviewedBy', 'reviewedAt', 'verifiedChannel', 'reviewNote'])
        && data.keys().hasOnly(['clubId', 'clubName', 'applicantId', 'reason', 'status', 'createdAt',
          'reviewedBy', 'reviewedAt', 'verifiedChannel', 'reviewNote'])
        && canonicalClubId(data.clubId) && validChatId(data.applicantId)
        && id == data.clubId + '__' + data.applicantId
        && data.clubName is string && data.clubName.size() >= 1 && data.clubName.size() <= 100
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 1000
        && data.reason.matches('(?s).*[^\\s].*') && data.createdAt is timestamp
        && data.status in ['pending', 'approved', 'rejected']
        && ((data.status == 'pending' && data.reviewedBy == null && data.reviewedAt == null
            && data.verifiedChannel == '' && data.reviewNote == '')
          || (data.status != 'pending' && data.reviewedBy is string && data.reviewedAt is timestamp
            && data.reviewNote is string && data.reviewNote.size() >= 1 && data.reviewNote.size() <= 1000
            && data.reviewNote.matches('(?s).*[^\\s].*')
            && data.verifiedChannel is string && data.verifiedChannel.size() <= 500
            && ((data.status == 'approved' && data.verifiedChannel.matches('https://[^\\s]+'))
              || (data.status == 'rejected' && data.verifiedChannel == ''))));
    }
    match /clubAdminRequests/{id} {
      allow get: if request.auth != null && (isOperator()
        || (exists(/databases/$(database)/documents/clubAdminRequests/$(id)) && resource.data.applicantId == request.auth.uid)
        || (!exists(/databases/$(database)/documents/clubAdminRequests/$(id))
          && id.split('__').size() == 2 && canonicalClubId(id.split('__')[0]) && id.split('__')[1] == request.auth.uid));
      allow list: if request.auth != null && (isOperator() || resource.data.applicantId == request.auth.uid);
      allow create: if request.auth != null && validAdminApplication(request.resource.data, id)
        && request.resource.data.applicantId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && unassignedClub(request.resource.data.clubId)
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && validAdminApplication(request.resource.data, id) && (
        (resource.data.applicantId == request.auth.uid && resource.data.status == 'rejected'
          && request.resource.data.status == 'pending' && unassignedClub(resource.data.clubId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reason', 'status', 'reviewedBy', 'reviewedAt', 'verifiedChannel', 'reviewNote']))
        || (isOperator() && request.auth.uid != resource.data.applicantId
          && resource.data.status == 'pending' && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'verifiedChannel', 'reviewNote'])
          && (request.resource.data.status == 'rejected'
            || (getAfter(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data.adminId == resource.data.applicantId
              && getAfter(/databases/$(database)/documents/clubs/$(resource.data.clubId)).data.updatedAt == request.time))));
    }
    function validRequestId(id, uid) {
      let parts = id.split('__');
      return id.size() <= 256 && parts.size() == 2 && parts[0] == uid
        && validChatId(parts[0]) && validChatId(parts[1]);
    }
    function validClubRequest(data) {
      return data.keys().hasAll(['applicantId', 'name', 'purpose', 'status', 'createdAt', 'reviewedBy', 'reviewedAt'])
        && data.keys().hasOnly(['applicantId', 'name', 'purpose', 'status', 'createdAt', 'reviewedBy', 'reviewedAt'])
        && data.applicantId is string
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 50
        && data.name.matches('(?s).*[^\\s].*')
        && data.purpose is string && data.purpose.size() >= 1 && data.purpose.size() <= 2000
        && data.purpose.matches('(?s).*[^\\s].*')
        && data.status in ['pending', 'approved', 'rejected'] && data.createdAt is timestamp;
    }
    match /clubRequests/{id} {
      allow get: if request.auth != null && (isOperator()
        || resource.data.applicantId == request.auth.uid
        || (!exists(/databases/$(database)/documents/clubRequests/$(id))
          && validRequestId(id, request.auth.uid)));
      allow list: if request.auth != null && (isOperator() || resource.data.applicantId == request.auth.uid);
      allow create: if request.auth != null && validRequestId(id, request.auth.uid)
        && validClubRequest(request.resource.data)
        && request.resource.data.applicantId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.reviewedBy == null && request.resource.data.reviewedAt == null;
      allow update: if isOperator() && validClubRequest(request.resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']);
      // 신청자 수정·삭제와 처리 완료 후 재변경은 허용하지 않는다.
    }
    function isParticipant(room) {
      return request.auth != null && request.auth.uid in room.participantIds;
    }
    function canReadMissingRoom(roomId) {
      let parts = roomId.split('__');
      return request.auth != null
        && !exists(/databases/$(database)/documents/chatRooms/$(roomId))
        && parts.size() == 2 && validChatId(parts[0]) && validChatId(parts[1])
        && parts[1] == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/clubs/$(parts[0])).data.adminId != request.auth.uid;
    }
    function validRoom(room, roomId) {
      return room.keys().hasAll(['clubId', 'studentId', 'adminId', 'participantIds', 'createdAt'])
        && room.keys().hasOnly(['clubId', 'studentId', 'adminId', 'participantIds', 'createdAt'])
        && validChatId(room.clubId) && validChatId(room.studentId) && validChatId(room.adminId)
        && room.studentId == request.auth.uid && room.studentId != room.adminId
        && roomId == room.clubId + '__' + room.studentId
        && room.participantIds is list && room.participantIds.size() == 2
        && room.participantIds.hasAll([room.studentId, room.adminId])
        && get(/databases/$(database)/documents/clubs/$(room.clubId)).data.adminId == room.adminId
        && exists(/databases/$(database)/documents/users/$(room.studentId))
        && exists(/databases/$(database)/documents/users/$(room.adminId))
        && room.createdAt is timestamp && room.createdAt == request.time;
    }
    match /chatRooms/{roomId} {
      allow get: if isParticipant(resource.data) || canReadMissingRoom(roomId);
      allow list: if isParticipant(resource.data);
      allow create: if request.auth != null && validRoom(request.resource.data, roomId);
      // 참여자·동아리·생성 시각을 포함한 방의 수정·삭제는 허용하지 않는다.
      match /messages/{messageId} {
        function participatesInParent() {
          return isParticipant(get(/databases/$(database)/documents/chatRooms/$(roomId)).data);
        }
        allow read: if participatesInParent();
        allow create: if participatesInParent()
          && request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.text.matches('(?s).*[^\\s].*')
          && request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time;
      }
    }
  }
}
