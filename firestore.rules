rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(data) {
      return data.keys().hasAll(['displayName', 'role', 'createdAt'])
        && data.keys().hasOnly(['displayName', 'role', 'createdAt'])
        && data.displayName is string
        && data.displayName.size() >= 1 && data.displayName.size() <= 30
        && data.displayName.matches('.*[^\\s].*')
        && data.role in ['student', 'club_admin']
        && data.createdAt is timestamp;
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.role == 'student'
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      // 목록 조회·삭제 및 나머지 경로는 기본 거절한다.
    }
    function validChatId(value) {
      return value is string && value.size() >= 1 && value.size() <= 128
        && value.split('__').size() == 1 && value.split('/').size() == 1;
    }
    // 채팅방 생성 시 현재 관리자 확인에 필요한 최소 단건 조회.
    // 동아리 목록·생성·수정 권한은 별도 담당 작업으로 남긴다.
    match /clubs/{clubId} {
      allow get: if request.auth != null;
      match /publicContacts/{contactId} {
        // 공개용 필드만 읽는다. 클라이언트의 편집·목록 조회는 허용하지 않는다.
        allow get: if request.auth != null
          && (!exists(/databases/$(database)/documents/clubs/$(clubId)/publicContacts/$(contactId))
            || validPublicContact(resource.data));
      }
    }
    function validPublicContact(data) {
      return data.keys().hasAll(['displayName', 'updatedAt'])
        && data.keys().hasOnly(['displayName', 'responseHint', 'updatedAt'])
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30
        && data.displayName.matches('(?s).*[^\\s].*') && data.updatedAt is timestamp
        && (!('responseHint' in data) || (data.responseHint is string
          && data.responseHint.size() >= 1 && data.responseHint.size() <= 120
          && data.responseHint.matches('(?s).*[^\\s].*')));
    }
    function isParticipant(room) {
      return request.auth != null && request.auth.uid in room.participantIds;
    }
    function canReadMissingRoom(roomId) {
      let parts = roomId.split('__');
      return request.auth != null
        && !exists(/databases/$(database)/documents/chatRooms/$(roomId))
        && parts.size() == 2 && validChatId(parts[0]) && validChatId(parts[1])
        && parts[1] == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/clubs/$(parts[0])).data.adminId != request.auth.uid;
    }
    function validRoom(room, roomId) {
      return room.keys().hasAll(['clubId', 'studentId', 'adminId', 'participantIds', 'createdAt'])
        && room.keys().hasOnly(['clubId', 'studentId', 'adminId', 'participantIds', 'createdAt'])
        && validChatId(room.clubId) && validChatId(room.studentId) && validChatId(room.adminId)
        && room.studentId == request.auth.uid && room.studentId != room.adminId
        && roomId == room.clubId + '__' + room.studentId
        && room.participantIds is list && room.participantIds.size() == 2
        && room.participantIds.hasAll([room.studentId, room.adminId])
        && get(/databases/$(database)/documents/clubs/$(room.clubId)).data.adminId == room.adminId
        && exists(/databases/$(database)/documents/users/$(room.studentId))
        && exists(/databases/$(database)/documents/users/$(room.adminId))
        && room.createdAt is timestamp && room.createdAt == request.time;
    }
    match /chatRooms/{roomId} {
      allow get: if isParticipant(resource.data) || canReadMissingRoom(roomId);
      allow list: if isParticipant(resource.data);
      allow create: if request.auth != null && validRoom(request.resource.data, roomId);
      // 참여자·동아리·생성 시각을 포함한 방의 수정·삭제는 허용하지 않는다.
      match /messages/{messageId} {
        function participatesInParent() {
          return isParticipant(get(/databases/$(database)/documents/chatRooms/$(roomId)).data);
        }
        allow read: if participatesInParent();
        allow create: if participatesInParent()
          && request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.text.matches('(?s).*[^\\s].*')
          && request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time;
      }
    }
  }
}
